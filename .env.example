# mode
# PLATFORM: local | naive
PLATFORM=local
# VOICE_MODE: sim | live
VOICE_MODE=sim
RUN_BUDGET_USD=5

# claude (agent runtime and LLM calls)
# Optional and unused in local mode: Claude runs through the local Claude Code login.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=sonnet

# local services (docker-compose)
DATABASE_URL=postgres://bill:bill@localhost:5433/billfighter
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API=http://localhost:8025
# Encrypts the local vault file
VAULT_KEY=
COMPANY_EMAIL=bills@billfighter.local
OWNER_PHONE_SIM=+15550001111

# data
OPENEI_API_KEY=

# payments
STRIPE_SECRET_KEY=sk_test_...

# voice (live mode only)
# VOICE_PROVIDER: retell | vapi
VOICE_PROVIDER=retell
RETELL_API_KEY=
VAPI_API_KEY=
# Twilio is optional: the demo does not use it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROVIDER_NUMBER=
TWILIO_CALLER_NUMBER=

# allowlist (our numbers, domains and portal URLs only)
ALLOWED_CALL_NUMBERS=
ALLOWED_EMAIL_DOMAINS=billfighter.local
ALLOWED_PORTAL_ORIGINS=http://localhost:3001

# naive (fill on Saturday)
NAIVE_API_KEY=
NAIVE_COMPANY_ID=
NAIVE_IDENTITY_ID=
NAIVE_CARD_ID=
NAIVE_CARD_CAP_USD=5
